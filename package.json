{
  "name": "quartz-skin-vector",
  "version": "0.2.0",
  "description": "Vector 2022 skin components for Quartz",
  "type": "module",
  "license": "GPL-2.0-or-later",
  "homepage": "https://github.com/Copartiper/quartz-skin-vector-2022",
  "keywords": [
    "quartz",
    "quartz-plugin",
    "skin",
    "vector",
    "vector-2022"
  ],
  "files": [
    "dist",
    "README.md",
    "README.zh_CN.md",
    "LICENSE",
    "CHANGELOG.md",
    "LICENSE.Vector",
    "NOTICE",
    "LICENSE.template",
    "src",
    "types",
    "tsup.config.ts",
    "tsconfig.json",
    "tsconfig.build.json",
    "test",
    "vitest.config.ts",
    "EXAMPLES.md",
    "ARCHITECTURE.md",
    "PERFORMANCE.md",
    "examples"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier . --check",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm run format && npm run test",
    "release": "npm run build && changeset publish",
    "prepublishOnly": "npm run build",
    "prepare": "npm run build",
    "test:browser": "npm run build && node test/browser.mjs",
    "test:install": "node test/installation.mjs",
    "test:performance": "npm run build && node test/performance.mjs"
  },
  "peerDependencies": {
    "preact": "^10.0.0",
    "vfile": "^6.0.3"
  },
  "peerDependenciesMeta": {
    "preact": {
      "optional": false
    },
    "vfile": {
      "optional": true
    }
  },
  "dependencies": {
    "@quartz-community/types": "^1.0.0",
    "@quartz-community/utils": "^1.0.1",
    "marked": "^18.1.1"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.0",
    "@playwright/test": "^1.64.1",
    "@types/hast": "^3.0.4",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.10.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "github-slugger": "^2.0.0",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "mdast-util-find-and-replace": "^3.0.2",
    "preact": "^10.28.2",
    "preact-render-to-string": "^6.8.1",
    "prettier": "^3.6.2",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "sass": "^1.97.3",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "vfile": "^6.0.3",
    "vitest": "^2.1.9"
  },
  "quartz": {
    "name": "vector-skin",
    "displayName": "Vector 2022",
    "category": [
      "component",
      "emitter"
    ],
    "version": "0.2.0",
    "quartzVersion": ">=5.0.0",
    "dependencies": [],
    "defaultOrder": 50,
    "defaultEnabled": true,
    "defaultOptions": {
      "locale": "auto",
      "wordmark": "",
      "tagline": "",
      "homeUrl": "",
      "defaultTheme": "auto",
      "defaultTextSize": "standard",
      "defaultWidth": "standard",
      "showAppearance": true,
      "logoUrl": "",
      "logoAlt": "",
      "revisionTimeZone": "Asia/Shanghai"
    },
    "optionSchema": {
      "locale": {
        "type": "enum",
        "values": [
          "auto",
          "en-US",
          "zh-CN"
        ]
      },
      "wordmark": {
        "type": "string"
      },
      "tagline": {
        "type": "string"
      },
      "homeUrl": {
        "type": "string"
      },
      "defaultTheme": {
        "type": "enum",
        "values": [
          "auto",
          "light",
          "dark"
        ]
      },
      "defaultTextSize": {
        "type": "enum",
        "values": [
          "small",
          "standard",
          "large"
        ]
      },
      "defaultWidth": {
        "type": "enum",
        "values": [
          "standard",
          "wide"
        ]
      },
      "showAppearance": {
        "type": "boolean"
      },
      "navigation": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "label": {
              "type": "string"
            },
            "href": {
              "type": "string"
            },
            "section": {
              "type": "string"
            }
          },
          "required": [
            "label",
            "href"
          ]
        }
      },
      "logoUrl": {
        "type": "string"
      },
      "logoAlt": {
        "type": "string"
      },
      "revisionTimeZone": {
        "type": "string"
      },
      "navigationTemplates": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string"
            },
            "collapsed": {
              "type": "boolean"
            },
            "above": {
              "type": "string"
            },
            "below": {
              "type": "string"
            },
            "rows": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "label": {
                    "type": "string"
                  },
                  "content": {
                    "type": "string"
                  }
                },
                "required": [
                  "label",
                  "content"
                ]
              }
            },
            "links": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "label": {
                    "type": "string"
                  },
                  "href": {
                    "type": "string"
                  }
                },
                "required": [
                  "label",
                  "href"
                ]
              }
            },
            "color": {
              "type": "object",
              "properties": {
                "light": {
                  "type": "string"
                },
                "dark": {
                  "type": "string"
                }
              }
            }
          },
          "required": [
            "title",
            "rows"
          ]
        }
      },
      "footerMarkdown": {
        "type": "string"
      },
      "footerTextColors": {
        "type": "object",
        "properties": {
          "light": {
            "type": "string"
          },
          "dark": {
            "type": "string"
          }
        }
      },
      "footerLinks": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "label": {
              "type": "string"
            },
            "href": {
              "type": "string"
            }
          },
          "required": [
            "label",
            "href"
          ]
        }
      },
      "footerParagraphs": {
        "type": "array",
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "text": {
                "type": "string"
              },
              "href": {
                "type": "string"
              },
              "bold": {
                "type": "boolean"
              }
            },
            "required": [
              "text"
            ]
          }
        }
      }
    },
    "components": {
      "VectorPage": {
        "displayName": "Vector 2022 page",
        "defaultPosition": "beforeBody",
        "defaultPriority": 0
      }
    }
  },
  "engines": {
    "node": ">=22",
    "npm": ">=10.9.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Copartiper/quartz-skin-vector-2022.git"
  }
}
